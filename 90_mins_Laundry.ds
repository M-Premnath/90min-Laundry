										// {
										for each  rec in input.Used_Inventory
										{
											info rec.Inventory_Items.Items;
											cusBranch = Pre_Booking[Cus_Booking_ID == input.Booking_ID].Nearby_Branch;
											invent_details = Inventory_Setup[Branch_ID == cusBranch && Inventory_Items == rec.Inventory_Items];
											if(invent_details == null)
											{
												alert "Sorry for the inconvenience. \n" + rec.Inventory_Items.Items + " is  Not Available.";
											}
											info "Branch from inventory update " + cusBranch;
											info "Inventory from inventory update " + invent_details.Inventory_ID;
										}
