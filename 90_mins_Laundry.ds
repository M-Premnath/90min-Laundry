		form Requesting_items
		{
			displayname = "Requesting items"
			success message = "Item Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Inventory_Items
			(
				type = picklist	
				displayname = "Inventory Items"
				values  = Inventory_Items.ID
    			displayformat = [Items]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Required_quantity
			(
				type = number
				displayname = "Required quantity"
				initial value = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
