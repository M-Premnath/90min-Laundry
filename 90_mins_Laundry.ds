			Redirect_Change_Status_Up as "Redirect, Change Status, Update Record"
			{
				type =  form
				form = Order_Processing
				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// openUrl("#Form:Order_Verification?Booking_ID=" + input.Booking_ID + "&Verification_Status=" + "Order Out","same window");
										openUrl("#Form:Inventory_Update?Booking_ID=" + input.Booking_ID + "&Sub_Process=" + input.Sub_Processes,"same window");
										// ------------------------------------ Update order status------------------------------------
										if(input.Booking_ID != null)
										{
											if(input.Order_status == "Order Dispatched")
											{
												booking = Pre_Booking[Cus_Booking_ID == input.Booking_ID];
												booking.Order_Status=input.Order_status;
												zap = Map();
												zap.put("token","9zmz9t7tokpne7nq");
												zap.put("to",booking.CustomerNumber);
												zap.put("type","chat");
												// HTML Body for Dispatched
												dispatch_body = "🚚 *Your Order Has Been Dispatched!* \n\n📝 *Order ID:* " + input.Booking_ID + "\n💰 *Total:* " + booking.Grand_Total + "\n\n📦 Your order is ready for pickup! \n📍 Please come and collect it from the same location where you dropped off your clothes.\n\n🙏 Thank you for choosing our service!";
												zap.put("body",dispatch_body);
												headers = Map();
												headers.put("content-type","application/json");
												response = invokeurl
												[
													url :"https://api.ultramsg.com/instance144169/messages/chat"
													type :POST
													parameters:zap.toString()
													headers:headers
												];
											}
										}
										// ------------------------------------ Update Inventory Data------------------------------------
										// if(input.Service_Process.Inventory_Items != null && input.Service_Process.Quantity_Used != null)
										// {
										// 	invent_details = Inventory_Master[Inventory_Items == input.Service_Process.Inventory_Items];
										// 	invent_details.Quantity=invent_details.Quantity - input.Service_Process.Quantity_Used;
										// }
						)
					}
					actions  (Order_status == "Order Dispatched")
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : Customer_Email
							subject : "Your Order Out for Delivered - 90min's Laundry"
							message : "<div><br></div>"
							attachments : template : Order_Dispatched as inline
						)
					}
				}

			}
