			displayname = "Staff Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\twebDeviceConfig='{\"layout\":{\"displayType\":\"card\",\"design\":\"fluid\",\"style\":\"padding-right:7px;padding-top:10px;padding-bottom:0px;padding-left:7px;\"}}'\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='31%'\n   \t>\n\t<dsp id='html_snippet2' elementName='HTML Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet2()\ncontent\n&lt;%{\n\t%&gt;\n&lt;style&gt;\n\t.zc-footer-wrapper{\n\t\tdisplay:none;\n\t}\n\t\n\t&lt;\/style&gt;\n&lt;div elName=&apos;zc-component&apos; formLinkName=&apos;Copy_of_Staff_Onboarding&apos; params=&apos;zc_Header=false&amp;amp;zc_SuccMsg=Data Added Successfully!&amp;amp;zc_SubmitVal=Submit&amp;amp;zc_ResetVal=Reset&apos;&gt;Loading Form...&lt;\/div&gt;\n&lt;%\n\n}%&gt;]]>\n<\/dsp>\n<\/column><column\n   \t\t width='69%'\n   \t>\n\t<panel elementName='Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgtype = 'gallery'\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tbgImageRepeat = 'no-repeat'\n\tbgImagePosition = 'fill'\n\tbgHorizontalAlign = 'center'\n\tbgVerticalAlign = 'center'\n\tbgImage = 'Holiday_Discount_Offer_Discount_Background_Wallpaper_Image_For_Free_Download_-_Pngtree_jfif.jpg'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgtype = 'gallery'\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tbgImageRepeat = 'no-repeat'\n\tbgImagePosition = 'fill'\n\tbgHorizontalAlign = 'center'\n\tbgVerticalAlign = 'center'\n\tbgImage = 'Holiday_Discount_Offer_Discount_Background_Wallpaper_Image_For_Free_Download_-_Pngtree_jfif.jpg'\n\n    borderColor = '#444444'\n    borderWidth = '0px'\n\t\twidth = '86%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n    \tcornerRadius = '0px'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = 'theme:65'\n\tsize = '33px'\n\tbold = 'true' \n\tfontFamily = 'heuristica, tinos, times, serif' \n\ttype = 'variable'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#000000'\n    borderWidth = '0px'\n\n\t  value = '${Staff_Name}'\n>\n<\/text>\n\n<\/pc><pc \n\t\n>\n\t<text \n\n\tmarginLeft = '10px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '10px'\n\tpadding = '0px'\n\tcolor = 'theme:65'\n\tsize = '16px'\n\titalic = 'true' \n\ttype = 'variable'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#000000'\n    borderWidth = '0px'\n\n\t  value = '${Branch_Name}'\n>\n<\/text>\n\n<\/pc>\n<\/pr>\n<\/pc><pc \n\t\tpaddingTop = '17px'\n\tpaddingLeft = '0px'\n\tpaddingRight = '17px'\n\tpaddingBottom = '17px'\n\tbgColor = '#F3F3F3'\n\n    borderColor = '#444444'\n    borderWidth = '0px'\n\t\twidth = '14%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n    \tcornerRadius = '0px'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<button \n\t\tmargin = '0px'\n\tpaddingTop = '12px'\n\tpaddingLeft = '15px'\n\tpaddingRight = '15px'\n\tpaddingBottom = '12px'\n\n    action = 'ExecuteFunction'\n\n\t\tparameters = '${Staff_ID}' \n\t\tfunctionName = 'Open_Detailed_View'  \n\tcolor = 'theme:75'\n\tsize = '15px'\n    borderColor = 'theme'\n    borderWidth = '1px'\n\ttext ='View Details'\n\t\tbgColor = '#FFFFFF'\n\t\tcornerRadius = '60px' \n\/>\n<\/pc>\n<\/pr>\n<\/pc>\n<\/pr>\n<\/pc>\n<\/pr>\n<\/panel>\n<\/column>\n<\/row><row>\n\t<column\n   \t\t width='26%'\n   \t>\n\t<dsp id='html_snippet3' elementName='HTML Snippet 1'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet3()\ncontent\n&lt;%{\n\tstaffDetails = Staff_Onboarding[ID == input.Staff_ID];\n\t%&gt;\n&lt;style&gt;\n    .id-card {\n        width: 98%;\n\t\theight:367px;\n        margin: auto;\n        border: 2px solid #094185;\n        border-radius: 7px;\n\t\ttext-align: center;\n        font-family: Arial, sans-serif;\n        background: linear-gradient(135deg, #f8f9fa, #e3f2fd);\n        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.4);\n    }\n\n    .id-header {\n        background-color: #094185;\n        color: #fff;\n        padding: 10px 0;\n        border-radius: 5px 5px 0 0;\n        font-size: 18px;\n        font-weight: bold;\n    }\n\n    .id-details {\n        margin-top: 10px;\n        text-align: left;\n        padding: 0 10px;\n\t\tgap:10px;\n    }\n\n    .id-details p {\n        margin: 20px 0;\n        font-size: 16px;\n    }\n\n    .id-footer {\n        background-color: #094185;\n        color: #fff;\n        margin-top: 25px;\n        padding: 5px 0;\n        border-radius: 0 0 5px 5px;\n        font-size: 13px;\n    }\n\t.profile-img {\n\t\tdisplay: flex;\n\t\tjustify-content: center;\n\t\talign-items: center;\n\t\tmargin: 15px auto;\n\t}\n\n\t.profile-img img {\n\t\twidth: 100px !important;\n\t\theight: 100px !important;\n\t\tborder-radius: 50%;\n\t\tobject-fit: cover;\n\t\tborder: 3px solid #007bff;\n\t\tbox-shadow: 0 4px 8px rgba(0,0,0,0.15);\n\t}\n\n\n&lt;\/style&gt;\n\n\n&lt;div class=&quot;id-card&quot;&gt;\n    &lt;div class=&quot;id-header&quot;&gt;Staff ID Card&lt;\/div&gt;\n\n&lt;div class=&quot;profile-img&quot; &gt;&lt;%=staffDetails.Staff_Profile%&gt;&lt;\/div&gt;\n\n\n    &lt;div class=&quot;id-details&quot;&gt;\n        &lt;p&gt;&lt;b&gt;Name:&lt;\/b&gt; &lt;%=staffDetails.Staff_Name%&gt;&lt;\/p&gt;\n\n       &lt;p&gt;&lt;b&gt;Branch:&lt;\/b&gt; &lt;%=input.Branch_Name%&gt;&lt;\/p&gt;\n        &lt;p&gt;&lt;b&gt;Contact:&lt;\/b&gt; &lt;%=staffDetails.Staff_Number%&gt;&lt;\/p&gt;\n        &lt;p&gt;&lt;b&gt;Email:&lt;\/b&gt; &lt;%=staffDetails.Staff_Email%&gt;&lt;\/p&gt;\n    &lt;\/div&gt;\n\n    &lt;div class=&quot;id-footer&quot;&gt;90MINS Laundry Solutions&lt;\/div&gt;\n&lt;\/div&gt;\n&lt;%\n\n}%&gt;]]>\n<\/dsp>\n<\/column><column\n   \t\t width='74%'\n   \t>\n\t<report \n\telementName='Report 1'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Most_Verified_Staff'\n\t\n\t\tiszreport = 'true'\n\theightType = 'custom'\n\theightValue = '100'\n\n\/>\n<\/column>\n<\/row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'All_Order_Verification'\n\t\tcriteriaString = 'Verifying_Staff.ID == input.Staff_ID'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n\n\/>\n<\/column>\n<\/row>\n<\/layout>\n<\/zml>"
		}
