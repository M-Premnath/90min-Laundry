		page Customer_Order_Tracker(string cusID)
		{
			displayname = "Customer Order Tracker"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\twebDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet1' elementName='HTML Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet1()\ncontent\n&lt;%{\n\tcusStatus = Pre_Booking[Cus_Booking_ID == input.cusID].Order_Status;\n\t%&gt;\n&lt;!DOCTYPE html&gt;\n&lt;html lang=&quot;en&quot;&gt;\n&lt;head&gt;\n  &lt;meta charset=&quot;UTF-8&quot;&gt;\n  &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;\n  &lt;title&gt;Order Tracker&lt;\/title&gt;\n   &lt;link rel=&quot;stylesheet&quot; href=&quot;https:\/\/cdnjs.cloudflare.com\/ajax\/libs\/font-awesome\/6.5.1\/css\/all.min.css&quot; crossorigin=&quot;anonymous&quot; referrerpolicy=&quot;no-referrer&quot; \/&gt;\n  &lt;style&gt;\n    body {\n      font-family: Arial, sans-serif;\n\n      margin: 0;\n      padding: 0;\n    }\n\n    .container {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\nbackground: #ffffff;\nbackground: radial-gradient(circle, rgba(255, 255, 255, 1) 0%, rgba(199, 199, 199, 1) 100%);\n      min-height: 70vh;\n      padding: 30px 0;\n    }\n\n    h1 {\n      margin-bottom: 40px;\n    }\n\n    .progressContainer {\n      position: relative;\n      width: 250px;\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      align-items: flex-start;\n      height: 400px;\n    }\n\n    \/* Base gray line *\/\n    .progress-line {\n      position: absolute;\n      top: 0;\n      left: 40px;\n      width: 6px;\n      height: 100%;\n      background-color: #dad7d7;\n      border-radius: 5px;\n      z-index: 1;\n    }\n\n    \/* Green fill line *\/\n    .progress-fill {\n      position: absolute;\n      top: 0;\n      left: 40px;\n      width: 6px;\n      height: 0%;\n      background-color: #4caf50;\n      border-radius: 5px;\n      z-index: 2;\n      transition: height 0.6s ease;\n    }\n\n    \/* Different progress levels *\/\n    .progress-20 .progress-fill { height: 20%; }\n\t.progress-40 .progress-fill { height: 40%; }\n    .progress-60 .progress-fill { height: 60%; }\n    .progress-80 .progress-fill { height: 80%; }\n    .progress-100 .progress-fill { height: 100%; }\n\n    \/* Step container row *\/\n    .stepContainer {\n      position: relative;\n      display: flex;\n      align-items: center;\n      gap: 5px;\n      z-index: 3;\n      width: 100%;\n    }\n\n    \/* Icon container on top of line *\/\n    .imgContainer {\n      position: absolute;\n      left: 22px;\n      background-color: #fff;\n      height: 40px;\n      width: 40px;\n      border-radius: 50%;\n      border: 2px solid #555;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      box-shadow: 2px 3px 5px rgba(0, 0, 0, 0.2);\n      z-index: 4;\n    }\n\n    .imgContainer i {\n      font-size: 18px;\n      color: black;\n    }\n\n    \/* Step text *\/\n    .stepContainer p {\n      margin-left: 70px;\n      font-weight: bold;\n      color: #333;\n    }\n\n    \/* Completed step color *\/\n    .completed .imgContainer {\n      background-color: #4caf50;\n      border-color: white;\n      color: white;\n    }\n\t.completed i {\n      color: white;\n    }\n\n  &lt;\/style&gt;\n\n&lt;\/head&gt;\n&lt;body&gt;\n  &lt;div class=&quot;container&quot;&gt;\n    &lt;h1&gt;Order Tracker&lt;\/h1&gt;\n&lt;%\n\tif(cusStatus == &quot;Order Placed&quot;)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;progressContainer  progress-20 &quot;&gt;\n      &lt;div class=&quot;progress-line&quot;&gt;&lt;\/div&gt;\n      &lt;div class=&quot;progress-fill&quot;&gt;&lt;\/div&gt;\n\t\t&lt;div class=&quot;stepContainer completed  &quot;&gt;\n        &lt;div class=&quot;imgContainer&quot;&gt;&lt;i class=&quot;fa fa-check&quot; aria-hidden=&quot;true&quot;&gt;&lt;\/i&gt;&lt;\/div&gt;\n        &lt;p&gt;Order Placed&lt;\/p&gt;\n        &lt;\/div&gt;\n\t\t\n\t\t&lt;div class=&quot;stepContainer &quot;&gt;\n        &lt;div class=&quot;imgContainer&quot;&gt;&lt;i class=&quot;fa-solid fa-box&quot;&gt;&lt;\/i&gt;&lt;\/div&gt;\n        &lt;p&gt;Order Accepted&lt;\/p&gt;\n        &lt;\/div&gt;\n\t\t\n\t\t&lt;div class=&quot;stepContainer  &quot;&gt;\n        &lt;div class=&quot;imgContainer&quot;&gt;&lt;i class=&quot;fa-solid fa-cogs&quot;&gt;&lt;\/i&gt;&lt;\/div&gt;\n        &lt;p&gt;Order Processing&lt;\/p&gt;\n      \t&lt;\/div&gt;\n\n      &lt;div class=&quot;stepContainer &quot;&gt;\n        &lt;div class=&quot;imgContainer&quot;&gt;&lt;i class=&quot;fa-solid fa-truck&quot;&gt;&lt;\/i&gt;&lt;\/div&gt;\n        &lt;p&gt;Order Dispatched&lt;\/p&gt;\n      &lt;\/div&gt;\n\n      &lt;div class=&quot;stepContainer &quot;&gt;\n        &lt;div class=&quot;imgContainer&quot;&gt;&lt;i class=&quot;fa-solid fa-house&quot;&gt;&lt;\/i&gt;&lt;\/div&gt;\n        &lt;p&gt;Order Delivered&lt;\/p&gt;\n      &lt;\/div&gt;\n\t  &lt;\/div&gt;\n&lt;%\n\t}\n\telse if(cusStatus == &quot;Order Accepted&quot;)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;progressContainer progress-40 &quot;&gt;\n      &lt;div class=&quot;progress-line&quot;&gt;&lt;\/div&gt;\n      &lt;div class=&quot;progress-fill&quot;&gt;&lt;\/div&gt;\n\t\t&lt;div class=&quot;stepContainer completed &quot;&gt;\n        &lt;div class=&quot;imgContainer&quot;&gt;&lt;i class=&quot;fa fa-check&quot;&gt;&lt;\/i&gt;&lt;\/div&gt;\n        &lt;p&gt;Order Placed&lt;\/p&gt;\n        &lt;\/div&gt;\n\t\t\n\t\t&lt;div class=&quot;stepContainer completed&quot;&gt;\n        &lt;div class=&quot;imgContainer&quot;&gt;&lt;i class=&quot;fa-solid fa-box&quot;&gt;&lt;\/i&gt;&lt;\/div&gt;\n        &lt;p&gt;Order Accepted&lt;\/p&gt;\n        &lt;\/div&gt;\n\t\t\n\t\t&lt;div class=&quot;stepContainer  &quot;&gt;\n        &lt;div class=&quot;imgContainer&quot;&gt;&lt;i class=&quot;fa-solid fa-cogs&quot;&gt;&lt;\/i&gt;&lt;\/div&gt;\n        &lt;p&gt;Order Processing&lt;\/p&gt;\n      \t&lt;\/div&gt;\n\n      &lt;div class=&quot;stepContainer &quot;&gt;\n        &lt;div class=&quot;imgContainer&quot;&gt;&lt;i class=&quot;fa-solid fa-truck&quot;&gt;&lt;\/i&gt;&lt;\/div&gt;\n        &lt;p&gt;Order Dispatched&lt;\/p&gt;\n      &lt;\/div&gt;\n\n      &lt;div class=&quot;stepContainer &quot;&gt;\n        &lt;div class=&quot;imgContainer&quot;&gt;&lt;i class=&quot;fa-solid fa-house&quot;&gt;&lt;\/i&gt;&lt;\/div&gt;\n        &lt;p&gt;Order Delivered&lt;\/p&gt;\n      &lt;\/div&gt;\n\t  &lt;\/div&gt;\n&lt;%\n\t}\n\telse if(cusStatus == &quot;Order Processing&quot;)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;progressContainer  progress-60&quot;&gt;\n      &lt;div class=&quot;progress-line&quot;&gt;&lt;\/div&gt;\n      &lt;div class=&quot;progress-fill&quot;&gt;&lt;\/div&gt;\n\t\t&lt;div class=&quot;stepContainer completed &quot;&gt;\n        &lt;div class=&quot;imgContainer&quot;&gt;&lt;i class=&quot;fa fa-check&quot;&gt;&lt;\/i&gt;&lt;\/div&gt;\n        &lt;p&gt;Order Placed&lt;\/p&gt;\n        &lt;\/div&gt;\n\t\t\n\t\t&lt;div class=&quot;stepContainer completed&quot;&gt;\n        &lt;div class=&quot;imgContainer&quot;&gt;&lt;i class=&quot;fa-solid fa-box&quot;&gt;&lt;\/i&gt;&lt;\/div&gt;\n        &lt;p&gt;Order Accepted&lt;\/p&gt;\n        &lt;\/div&gt;\n\t\t\n\t\t&lt;div class=&quot;stepContainer completed &quot;&gt;\n        &lt;div class=&quot;imgContainer&quot;&gt;&lt;i class=&quot;fa-solid fa-cogs&quot;&gt;&lt;\/i&gt;&lt;\/div&gt;\n        &lt;p&gt;Order Processing&lt;\/p&gt;\n      \t&lt;\/div&gt;\n\n      &lt;div class=&quot;stepContainer &quot;&gt;\n        &lt;div class=&quot;imgContainer&quot;&gt;&lt;i class=&quot;fa-solid fa-truck&quot;&gt;&lt;\/i&gt;&lt;\/div&gt;\n        &lt;p&gt;Order Dispatched&lt;\/p&gt;\n      &lt;\/div&gt;\n\n      &lt;div class=&quot;stepContainer &quot;&gt;\n        &lt;div class=&quot;imgContainer&quot;&gt;&lt;i class=&quot;fa-solid fa-house&quot;&gt;&lt;\/i&gt;&lt;\/div&gt;\n        &lt;p&gt;Order Delivered&lt;\/p&gt;\n      &lt;\/div&gt;\n\t  &lt;\/div&gt;\n&lt;%\n\t}\n\telse if(cusStatus == &quot;Order Dispatched&quot;)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;progressContainer progress-80&quot;&gt;\n      &lt;div class=&quot;progress-line&quot;&gt;&lt;\/div&gt;\n      &lt;div class=&quot;progress-fill&quot;&gt;&lt;\/div&gt;\n\t\t&lt;div class=&quot;stepContainer completed  &quot;&gt;\n        &lt;div class=&quot;imgContainer&quot;&gt;&lt;i class=&quot;fa fa-check&quot;&gt;&lt;\/i&gt;&lt;\/div&gt;\n        &lt;p&gt;Order Placed&lt;\/p&gt;\n        &lt;\/div&gt;\n\t\t\n\t\t&lt;div class=&quot;stepContainer completed&quot;&gt;\n        &lt;div class=&quot;imgContainer&quot;&gt;&lt;i class=&quot;fa-solid fa-box&quot;&gt;&lt;\/i&gt;&lt;\/div&gt;\n        &lt;p&gt;Order Accepted&lt;\/p&gt;\n        &lt;\/div&gt;\n\t\t\n\t\t&lt;div class=&quot;stepContainer completed &quot;&gt;\n        &lt;div class=&quot;imgContainer&quot;&gt;&lt;i class=&quot;fa-solid fa-cogs&quot;&gt;&lt;\/i&gt;&lt;\/div&gt;\n        &lt;p&gt;Order Processing&lt;\/p&gt;\n      \t&lt;\/div&gt;\n\n      &lt;div class=&quot;stepContainer completed &quot;&gt;\n        &lt;div class=&quot;imgContainer&quot;&gt;&lt;i class=&quot;fa-solid fa-truck&quot;&gt;&lt;\/i&gt;&lt;\/div&gt;\n        &lt;p&gt;Order Dispatched&lt;\/p&gt;\n      &lt;\/div&gt;\n\n      &lt;div class=&quot;stepContainer &quot;&gt;\n        &lt;div class=&quot;imgContainer&quot;&gt;&lt;i class=&quot;fa-solid fa-house&quot;&gt;&lt;\/i&gt;&lt;\/div&gt;\n        &lt;p&gt;Order Delivered&lt;\/p&gt;\n      &lt;\/div&gt;\n\t  &lt;\/div&gt;\n&lt;%\n\t}\n\telse if(cusStatus == &quot;Order Delivered&quot;)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;progressContainer progress-100 &quot;&gt;\n      &lt;div class=&quot;progress-line&quot;&gt;&lt;\/div&gt;\n      &lt;div class=&quot;progress-fill&quot;&gt;&lt;\/div&gt;\n\t\t&lt;div class=&quot;stepContainer completed  &quot;&gt;\n        &lt;div class=&quot;imgContainer&quot;&gt;&lt;i class=&quot;fa fa-check&quot;&gt;&lt;\/i&gt;&lt;\/div&gt;\n        &lt;p&gt;Order Placed&lt;\/p&gt;\n        &lt;\/div&gt;\n\t\t\n\t\t&lt;div class=&quot;stepContainer completed&quot;&gt;\n        &lt;div class=&quot;imgContainer&quot;&gt;&lt;i class=&quot;fa-solid fa-box&quot;&gt;&lt;\/i&gt;&lt;\/div&gt;\n        &lt;p&gt;Order Accepted&lt;\/p&gt;\n        &lt;\/div&gt;\n\t\t\n\t\t&lt;div class=&quot;stepContainer completed &quot;&gt;\n        &lt;div class=&quot;imgContainer&quot;&gt;&lt;i class=&quot;fa-solid fa-cogs&quot;&gt;&lt;\/i&gt;&lt;\/div&gt;\n        &lt;p&gt;Order Processing&lt;\/p&gt;\n      \t&lt;\/div&gt;\n\n      &lt;div class=&quot;stepContainer completed&quot;&gt;\n        &lt;div class=&quot;imgContainer&quot;&gt;&lt;i class=&quot;fa-solid fa-truck&quot;&gt;&lt;\/i&gt;&lt;\/div&gt;\n        &lt;p&gt;Order Dispatched&lt;\/p&gt;\n      &lt;\/div&gt;\n\n      &lt;div class=&quot;stepContainer completed &quot;&gt;\n        &lt;div class=&quot;imgContainer&quot;&gt;&lt;i class=&quot;fa-solid fa-house&quot;&gt;&lt;\/i&gt;&lt;\/div&gt;\n        &lt;p&gt;Order Delivered&lt;\/p&gt;\n      &lt;\/div&gt;\n\t  &lt;\/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;\/div&gt;\n&lt;\/body&gt;\n&lt;\/html&gt;\n&lt;%\n\n}%&gt;]]>\n<\/dsp>\n<\/column>\n<\/row>\n<\/layout>\n<\/zml>"
		}
		page Branch_Dashboard(int Branch_ID, string Branch_Name)
		{
			displayname = "Branch Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='32%'\n   \t>\n\t<dsp id='html_snippet' elementName='HTML Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet()\ncontent\n&lt;%{\n\t%&gt;\n&lt;style&gt;\n\t.zc-footer-wrapper{\n\t\tdisplay:none;\n\t}\n\t\n\t&lt;\/style&gt;\n&lt;div elName=&apos;zc-component&apos; formLinkName=&apos;Stateless_Branch_Master&apos; params=&apos;zc_Header=false&amp;amp;zc_SuccMsg=Data Added Successfully!&amp;amp;zc_SubmitVal=Submit&amp;amp;zc_ResetVal=Reset&apos;&gt;Loading Form...&lt;\/div&gt;\n&lt;%\n\n}%&gt;]]>\n<\/dsp>\n<\/column><column\n   \t\t width='68%'\n   \t>\n\t<panel elementName='Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgtype = 'gallery'\n\tbgColor = '#FFFFFF'\n\tbgImageRepeat = 'no-repeat'\n\tbgImagePosition = 'fill'\n\tbgHorizontalAlign = 'center'\n\tbgVerticalAlign = 'center'\n\tbgImage = 'Holiday_Discount_Offer_Discount_Background_Wallpaper_Image_For_Free_Download_-_Pngtree_jfif.jpg'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = 'theme:75'\n\tsize = '24px'\n\tfontFamily = 'roboto-regular' \n\ttype = 'variable'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = '${Branch_Name}'\n>\n<\/text>\n\n<\/pc>\n<\/pr>\n<\/pc>\n<\/pr>\n<\/panel>\n<\/column>\n<\/row><row>\n\t<column\n   \t\t width='31%'\n   \t>\n\t<board\n    \n\tbgColor = '#FFFFFF'\n        bgColorType = 'solid'\n\tpadding = '0px'\nelementName='Board'\n    layoutType = 'grid'\n        items = '1'\n    appLinkName = 'thisapp'\n    formLinkName = 'Pre_Booking'\n    rankBy = 'ID'\n    rankOrder = 'highestToLowest'\n    rankAggregate = 'count'\n    limit = '8'\n    groupBy = 'Order_Status'\n 