			update_Inventory_used as "update Inventory used"
			{
				type =  form
				form = Inventory_Update
				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ------------------------------------ Update Inventory Data------------------------------------
										if(Used_Inventory.Quantity_Used != null)
										{
											for each  inn in input.Used_Inventory
											{
												cusBranch = Pre_Booking[Cus_Booking_ID == input.Booking_ID].Nearby_Branch;
												invent_details = Inventory_Setup[Branch_ID == cusBranch && Inventory_Items == inn.Inventory_Items];
												invent_details.Quantity=invent_details.Quantity - inn.Quantity_Used;
											}
											openUrl("#Report:Pre_Booking_Report","same window");
										}
						)
					}
				}

			}
