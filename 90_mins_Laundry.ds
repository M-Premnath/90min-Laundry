				type =  form
				form = Inventory_Update
				record event = on add or edit

				on add row of Used_Inventory
				{
					actions 
					{
						custom deluge script
						(
											cusBranch = Pre_Booking[Cus_Booking_ID == input.Booking_ID].Nearby_Branch;
										invent_details = Inventory_Setup[Branch_ID == cusBranch && Inventory_Items != null].Inventory_Items.getAll();
