		approval
		{
			Requesting_Inventory as "Requesting Inventory"
			{
				type =  approval
				form = Inventory_Request
				display fields = [Branch_ID,Branch_Name,Requesting_Staff]
				on start
				{
				}
				on level 1
				{
					approvers
					(
		 				role = "CEO"
					)
					on approve 
					{
						actions 
						{
							sendmail
							(
								from : zoho.loginuserid
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been approved."
							)
						}
					}
					on reject
					{

						actions 
						{
							sendmail
							(
								from : zoho.loginuserid
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been rejected."
							)
						}
					}
				}
			}
		}

		blueprint
		{
    			Order_Status as "Order Status"
    			{
        			type = Blueprint
        			form = Pre_Booking[Order_Status == "Order Accepted"]
        			status = inactive
        			start
        			{
            			start stage = "Order Accepted"
            			chart data
            			{
                			from port : B
                			to port   : T3
                			position  : "62.33333333333343 55.66666666666667"
                			path      : [90.18333333333342,92.50666666666667,90.18333333333342,102.50666666666667,90.18333333333342,102.62357688849767,-168.01446431381498,102.62357688849767,-168.01446431381498,102.74048711032864,-168.01446431381498,112.74048711032864]
            			}
        			}
        			stages
        			{
           			"Order Accepted"
           			{
               			chart data
               			{
                   			position : "-239 112.74048711032864"
               			}
           			}
           			"Order Processing"
           			{
               			chart data
               			{
                   			position : "-244 241.74048711032862"
               			}
           			}
        			}
        			transitions
        			{
    				Start_Processing as "Start Processing"
    				{
         				type = normal
         				from stage = "Order Accepted"
         				to stage = "Order Processing"
         				before
         				{
         				}
         				after
         				{
							actions 
							{
								custom deluge script
								(
															// change the status to order Processing once process Accepted
														openUrl("#Form:Order_Processing?Booking_ID=" + input.Cus_Booking_ID + "&Branch_Name=" + input.Nearby_Branch.Branch_Name + "&Customer_Name=" + input.Customer_Name,"same window");
								)
							}
         				}
         				chart data
         				{
             				from port : B3
             				to port   : T3
             				path      : [-168.01446431381498,164.34831690555026,-168.01446431381498,174.34831690555026,-168.01446431381498,203.04440200793942,-169.2204732249478,203.04440200793942,-169.2204732249478,231.74048711032862,-169.2204732249478,241.74048711032862]
        				}
  				}
        			}
    			}
		}


		functions
		{
			Open_Dashboard as "Open Dashboard"
			{
				type =  functions
				form = Branch_Setup
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Page:Branch_Dashboard?Branch_ID=" + input.ID + "&Branch_Name=" + input.Branch_Name,"same window");
					)
					}
				}
			}
			update_order_status as "update order status"
			{
				type =  functions
				form = Pre_Booking
				execution type = for each record	
				on start
				{
					actions  (Order_Status != "Payment Pending")
					{
					on click
					(
						// change the status to order Processing once process Accepted
										if(input.Order_Status == "Order Placed")
										{
											openUrl("#Form:Order_Verification?Verification_Status=" + "Order In" + "&Booking_ID=" + input.Cus_Booking_ID + "&Order_Status=" + "Order Accepted" + "&Payment_Status=Completed","same window");
										}
										else if(input.Order_Status == "Order Processing" || input.Order_Status == "Order Accepted")
										{
											openUrl("#Form:Order_Processing?Booking_ID=" + input.Cus_Booking_ID + "&Branch_Name=" + input.Nearby_Branch.Branch_Name + "&Customer_Name=" + input.Customer_Name + "&Customer_Email=" + input.Customer_Email,"same window");
										}
										else if(input.Order_Status == "Order Dispatched")
										{
											openUrl("#Form:Order_Verification?Verification_Status=" + "Order Out" + "&Booking_ID=" + input.Cus_Booking_ID + "&Order_Status=" + "Order Delivered","same window");
										}
					)
					}
				}
			}
			open_Tracker as "open Tracker"
			{
				type =  functions
				form = Pre_Booking
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						//Open Tracker Page with customer Booking ID
										openUrl("#Page:Customer_Order_Tracker?cusID=" + input.Cus_Booking_ID,"popup window","height=<height>,width=<width>");
					)
					}
				}
			}
			Order_Tracker as "Order Tracker"
			{
				type =  functions
				form = Pre_Booking
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Page:Customer_Order_Tracker?cusID=" + input.Cus_Booking_ID,"popup window","height=<height>,width=<width>");
					)
					}
				}
			}
			Update_Inventory_Quantity as "Update Inventory Quantity"
			{
				type =  functions
				form = Inventory_Setup
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:Stock_Update?Branch_Name=" + input.Branch_ID.Branch_Name + "&Inventory_Item=" + input.Inventory_Items.Items + "&Available_Quantity=" + input.Quantity,"popup window","height=<height>,width=<width>");
					)
					}
				}
			}
		}
	}
