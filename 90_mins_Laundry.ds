		 functions
		 {
			 Deluge
			 {
				 void Open_Detailed_View(int Staff_ID)
                 {
                 	openUrl("https://creatorapp.zoho.in/zappyworkssoftwaresolutionst22/mins-laundry/record-summary/All_Current_Staff/" + input.Staff_ID,"new window");
                 }
				 void RemovePastdays(date date)
                 {
                 	// 	info "Before if "+date;
                 	if(date < zoho.currentdate)
                 	{
                 		info "Your are selecting the past date. So choose more than the current date ";
                 		date = zoho.currenttime;
                 		// 		info date;
                 	}
                 }
				 void testcrm()
                 {
                 	emp_map = Map();
                 	emp_map.put("First_Name","Test");
                 	emp_map.put("Last_Name","CRM2");
                 	emp_map.put("Email","test@gmail.com");
                 	emp_map.put("Phone","9629565554");
                 	emp_map.put("Street","test Street");
                 	emp_map.put("Company","Laundry Service");
                 	emp_map.put("State","TamilNadu");
                 	emp_map.put("Zip_Code","624308");
                 	emp_map.put("City","Chennai");
                 	emp_map.put("Country","India");
                 	emp_map.put("Lead_Source","Self");
                 	emp2_map = List();
                 	emp2_map.add(emp_map);
                 	payload = Map();
                 	payload.put("data",emp2_map);
                 	response = invokeurl
                 	[
                 		url :"https://www.zohoapis.in/crm/v2/Leads"
                 		type :POST
                 		parameters:payload.toString()
                 		connection:"zohocrm_connection"
                 	];
                 	info response;
                 }
				 void test_location()
                 {
                 	zap = Map();
                 	zap.put("token","ptciidm4v3zj2p9p");
                 	zap.put("to","9629565554");
                 	zap.put("body","✅ *Order Placed!* \n\n🧺 Your order has been placed successfully.\n\n📍 Kindly drop your clothes at the below location.\n\n📝 *Order ID:* " + "Test_101" + "\n💰 *Total:* " + 900 + "\n\n🙏 Thank you for choosing us!");
                 	headers = Map();
                 	headers.put("content-type","application/json");
                 	var = invokeurl
                 	[
                 		url :"https://api.ultramsg.com/instance144123/messages/chat"
                 		type :POST
                 		parameters:zap.tostring()
                 		headers:headers
                 	];
                 	zap = Map();
                 	zap.put("token","ptciidm4v3zj2p9p");
                 	zap.put("to","9629565554");
                 	zap.put("address","ABC company \n Sixth floor , office 38");
                 	zap.put("lat","25.197197");
                 	zap.put("lng","55.2721877");
                 	headers = Map();
                 	headers.put("content-type","application/json");
                 	var = invokeurl
                 	[
                 		url :"https://api.ultramsg.com/instance144123/messages/location"
                 		type :POST
                 		parameters:zap.tostring()
                 		headers:headers
                 	];
                 }
				 bool ValidateAge(date DOB)
                 {
                 	age = DOB.yearsBetween(today);
                 	if(age > 18)
                 	{
                 		return true;
                 	}
                 	return false;
                 }
			 }
		 }
		workflow
		{
		form
		{
			Create_Branch_ID as "Create Branch ID"
			{
				type =  form
				form = Branch_Setup
				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											branch_details = Branch_Setup[ID != null];
										Name = input.Branch_Name.subString(0,3).toUpperCase();
										num = branch_details.count().toText();
										input.Branch_ID = Name + "-" + num;
						)
					}
				}

			}
			Hide as "Hide"
			{
				type =  form
				form = Branch_Setup
				record event = on add or edit

				field rules
				{
					actions 
					{
						hide Branch_ID;
					}
				}

			}
			Fetch_Inventory_Items as "Fetch Inventory Items"
			{
				type =  form
				form = Inventory_Setup
				record event = on add or edit

				on user input of Inventory_Category
				{
					actions 
					{
						custom deluge script
						(
											inventory_items = Inventory_Items[Inventory_Category == input.Inventory_Category].ID.getAll();
										// info inventory_items;
										input.Inventory_Items:ui.add(inventory_items);
						)
					}
				}

			}
			Fetch_Inventory_Items1 as "Fetch Inventory Items"
			{
				type =  form
				form = Inventory_Setup
				record event = on add or edit

				on user input of Inventory_Items
				{
					actions 
					{
						custom deluge script
						(
											if(input.Inventory_Category == null && input.Inventory_Items != null)
										{
											input.Inventory_Items = null;
											focus Inventory_Category;
										}
										else if(input.Inventory_Category != null && input.Inventory_Items != null)
										{
											input.Unit_cost = input.Inventory_Items.cost_per_item;
											input.Inventory_Cost = input.Unit_cost * input.Quantity;
										}
						)
					}
				}

			}
			Calculate_Inventory_Cost as "Calculate Inventory Cost"
			{
				type =  form
				form = Inventory_Setup
				record event = on add or edit

				on user input of Quantity
				{
					actions 
					{
						custom deluge script
						(
											if(input.Quantity != null)
										{
											if(input.Quantity > 0)
											{
												input.Inventory_Cost = input.Unit_cost * input.Quantity;
											}
											else
											{
												alert "Enter a valid Quantity";
												input.Quantity = 1;
											}
										}
						)
					}
				}

			}
			Generate_Staff_ID as "Generate Staff ID"
			{
				type =  form
				form = Staff_Onboarding
				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Generate Staff ID
										count = Staff_Onboarding[ID != null].count();
										serial = (100 + count).toString();
										input.Staff_ID = "Staff-" + serial;
						)
					}
				}

			}
			validate_date_of_birth as "validate date of birth"
			{
				type =  form
				form = Staff_Onboarding
				record event = on add or edit

				on user input of DOB
				{
					actions 
					{
						custom deluge script
						(
											if(DOB != null)
										{
											age = input.DOB.yearsBetween(today);
											if(age < 18)
											{
												alert "You are Not eligibe to Work \n Only above 18 age is allowed.";
											}
										}
						)
					}
				}

			}
			Show_Hide as "Show / Hide"
			{
				type =  form
				form = Staff_Onboarding
				record event = on add or edit

				field rules
				{
					actions  (Previous_Experience == "Yes")
					{
						show Experience_Section;
					}
					actions 
					{
