										zap = Map();
										zap.put("token","9zmz9t7tokpne7nq");
										zap.put("to",input.CustomerNumber);
										zap.put("address",input.Branch_Address.address_line_1);
										zap.put("lat",input.Branch_Address.latitude);
										zap.put("lng",input.Branch_Address.longitude);
										headers = Map();
										headers.put("content-type","application/json");
										var = invokeurl
										[
											url :"https://api.ultramsg.com/instance144169/messages/location"
											type :POST
											parameters:zap.tostring()
											headers:headers
										];
						)
					}
				}

			}
			send_Mail_Request as "send Mail Request"
			{
				type =  form
				form = Inventory_Request
				record event = on add

				on success
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : Requesting_Email
							subject : "Requesting Inventory form ${Branch_Name}"
							message : "<div>Dear Management team,<br></div><div><br></div><div>As a staff in 90min's Laundry at&nbsp;${Branch_Name}. we are Running out of stock so kindly do the needful.<br></div><div><br></div><div><br></div><div>Regards,<br></div><div>90min's Laundry<br></div><div>${Branch_Name}<br></div>"
							attachments : template : Inventory_Request as pdf
						)
					}
				}

			}
			Fetch_Staff_mail_id as "Fetch Staff mail id"
			{
				type =  form
				form = Inventory_Request
				record event = on add or edit

				on user input of Requesting_Staff
				{
					actions 
					{
						custom deluge script
						(
											input.Requesting_Email = input.Requesting_Staff.Staff_Email;
						)
					}
				}

			}
			Validate_Quantity as "Validate Quantity"
			{
				type =  form
				form = Inventory_Request
				record event = on add or edit

				on user input of Requesting_Inventory.Required_quantity
				{
					actions 
					{
						custom deluge script
						(
											if(row.Required_quantity != null)
										{
											if(row.Required_quantity <= 0)
											{
												alert "Enter minimum 1 Quantity";
												row.Required_quantity=1;
											}
										}
						)
					}
				}

			}
			Hide9 as "Hide"
			{
				type =  form
				form = Inventory_Request
				record event = on add or edit

				field rules
				{
					actions 
					{
						disable Branch_Name;
					}
				}

			}
			Set_open_url_values as "Set open url values"
			{
				type =  form
				form = Copy_of_Staff_Onboarding
				record event = on add

				on user input of Staff_ID
				{
					actions 
					{
						custom deluge script
						(
											staffdata = Staff_Onboarding[ID == input.Staff_ID];
										openUrl("#Page:Staff_Dashboard?Branch_Name=" + staffdata.Branch_Preference.Branch_Name + "&Branch_ID=" + staffdata.Branch_Preference + "&Staff_Name=" + staffdata.Staff_Name + "&Staff_ID=" + staffdata.ID,"same window");
						)
					}
				}

			}
		}

		schedule
		{
			Stock_Updates as "Stock Updates"
			{
				type =  schedule
				start = "2025-09-01 21:00:00"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
