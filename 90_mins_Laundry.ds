			Redirect_to_Booking_Repor as "Redirect to Booking Report"
			{
				type =  form
				form = Order_Verification
				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(Order_Status == "Order Accepted" && Cloths_Received == true)
										{
											fet = Pre_Booking[Cus_Booking_ID == input.Booking_ID];
											fet.Order_Status=input.Order_Status;
											openUrl("#Form:Order_Processing?Booking_ID=" + input.Booking_ID + "&Branch_Name=" + input.Branch_Name + "&Customer_Name=" + input.Customer_Name + "&Customer_Email=" + input.Customer_Email,"same window");
											//--------------------------------Whatapp Integration --------------------------------
											bookdata = Pre_Booking[Cus_Booking_ID == input.Booking_ID];
											zap = Map();
											zap.put("token","9zmz9t7tokpne7nq");
											zap.put("to",bookdata.CustomerNumber);
											zap.put("type","chat");
											// HTML Body with formatting & emojis
											html_body = "✅ *Order Accepted and Processing Initiated!* \n\n" + "\n🛒 Thank you for shopping with us." + "\n📦 Your order is now being processed.\n\n📝 *Order ID:* " + input.Booking_ID + "\n" + "💰 *Total:* " + fet.Grand_Total + "\n\n🚚 You’ll receive another update once your order is Dispatched.\n\n🙏 _We appreciate your trust in us!_";
											zap.put("body",html_body);
											headers = Map();
											headers.put("content-type","application/json");
											response = invokeurl
											[
												url :"https://api.ultramsg.com/instance144169/messages/chat"
												type :POST
												parameters:zap.toString()
												headers:headers
											];
										}
										else if(Order_Status == "Order Accepted" && Cloths_Received == false)
										{
											fet = Pre_Booking[Cus_Booking_ID == input.Booking_ID];
											fet.Order_Status="Order Placed";
											openUrl("#Report:Pre_Booking_Report","parent window");
										}
										else if(Order_Status == "Order Delivered" && Cloths_Delivered == true)
										{
											openUrl("#Page:Website","parent window");
											fet = Pre_Booking[Cus_Booking_ID == input.Booking_ID];
											fet.Order_Status=input.Order_Status;
											zap = Map();
											zap.put("token","9zmz9t7tokpne7nq");
											zap.put("to",fet.CustomerNumber);
											zap.put("type","chat");
											// HTML Body for Delivered
											delivered_body = "🎉 *Order Delivered Successfully!* \n\n📝 *Order ID:* " + input.Booking_ID + "\n💰 *Total:* " + fet.Grand_Total + "\n\n📦 We hope you enjoy your purchase.\n⭐ Please share your feedback with us.\n\n🙏 Thank you for trusting us!";
											zap.put("body",delivered_body);
											headers = Map();
											headers.put("content-type","application/json");
											response = invokeurl
											[
												url :"https://api.ultramsg.com/instance144169/messages/chat"
												type :POST
												parameters:zap.toString()
												headers:headers
											];
										}
										else if(Order_Status == "Order Delivered" && Cloths_Delivered == false)
										{
											fet = Pre_Booking[Cus_Booking_ID == input.Booking_ID];
											fet.Order_Status="Order Dispatched";
											openUrl("#Report:Pre_Booking_Report","parent window");
										}
						)
					}
				}

			}
			Fetch_booked_service_deta as "Fetch booked service details"
			{
				type =  form
				form = Order_Processing
				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											bookDetails = Pre_Booking[Cus_Booking_ID == input.Booking_ID];
										var = bookDetails.Service_Details.getall();
										for each  rec in var
										{
											ser = Order_Processing.Service_Process();
											ser.Service_Type=rec.Service_Type;
											ser.Cloths_Types=rec.Cloths_Types;
											ser.Service_Duration=rec.Service_Duration;
											input.Service_Process.insert(ser);
										}
										input.Completion_Time = input.Service_Process.sum(Service_Duration);
										// bookDetails = Pre_Booking[ID == input.Pre_Booking];
										// var = bookDetails.Service_Details.getall();
										// for each  rec in var
										// {
										// 	ser = Order_Processing.Service_Process();
										// 	ser.Service_Type=rec.Service_Type;
										// 	ser.Cloths_Types=rec.Cloths_Types;
										// 	ser.Service_Duration = rec.Service_Duration;
										// 	input.Service_Process.insert(ser);
										// }
										// ------------------------------------ Disable subform fields -----------------
										disable Service_Process.Service_Type;
										disable Service_Process.Cloths_Types;
										disable Service_Process.Service_Duration;
						)
					}
				}

			}
