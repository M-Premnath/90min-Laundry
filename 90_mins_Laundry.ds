		form Payment
		{
			title 
    		{
    			on add = "Payment"
   	 			on edit = "Payment Processing"
			}
			success message = "Payment Completed Successfully"
			feature property = 256
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Booking_ID
			(
    			type = text
				displayname = "Booking ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Cus_Name
			(
    			type = text
				displayname = "Cus Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Cus_Email
			(
    			type = email
				displayname = "Cus Email"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Service_Type
			(
    			type = textarea
				displayname = "Service Type"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Branch_Details
			(
    			type = text
				displayname = "Branch Details"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Payment_Date
			(
    			type = date
				displayname = "Payment Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Transaction_Amount
			(
				displayname = "Transaction Amount"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			plain
			(
    			type = plaintext
				value = "<div><img height=\"65%\" width=\"30%\" src=\"https://ik.imagekit.io/ofn6h4ndi/Beige%20Crumpled%20Paper%20Phone%20Wallpaper.png?updatedAt=1760634273348\"> <br /></div>"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Pre_Booking
			(
				type = picklist	
				displayname = "Pre Booking"
				values  = Pre_Booking.ID
    			displayformat = [Cus_Booking_ID]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Payment_Status
			(
				type = picklist
				displayname = "Payment Status"
				maxchar = 100
				values = {"Completed","In Complete"}
				initial value = "Completed"
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Pre_Booking
		{
