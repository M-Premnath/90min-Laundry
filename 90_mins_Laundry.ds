		calendar Weekly_Order_Report
		{
			displayName = "Weekly  Order Report"
			show all rows from Pre_Booking    
			(
				Booking_Date as "Booking Date"
				CustomerNumber
				(
					displayformat = plainnumber 
					linktodial = enable
				)
				Grand_Total as "Grand Total"
				Order_Status as "Order Status"
				Added_Time as "Added Time"
				Customer_Address  as "Customer Address"
	 			(
	      			displayformat = [address_line_1+""+address_line_2+""+district_city+""+state_province+""+postal_Code+""+country]
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Customer_Name  as "Customer Name"
	 			(
	      			displayformat = [first_name+""+prefix+""+last_name+""+suffix]
	 			)
				Payment_Method as "Payment Method"
				Customer_Email as "Customer Email"
				Nearby_Branch as "Nearby Branch"
				Cus_Booking_ID as "Cus Booking ID"
			)
			options
			(
				display type = week
				week start day = sunday
				display field = Order_Status
				start date = Added_Time
				end date = Booking_Date
				default date 
				(
	    			day   = Today
	    			month = Currentmonth
	    			year  = Currentyear
				)
			)
			custom actions
			(
				"Track Order"
				(
	  			workflow = open_Tracker
				show action in view header = true
				show action in edit record menu = true
				)
			)
			conditional formatting
			(
				"Placed"
				{
				condition = (Order_Status == "Order Placed")
				fields = [Order_Status]
				format = "font-weight:bold;color:#ffffff;background-color:#808080;"
				}
				"Accepted"
				{
				condition = (Order_Status == "Order Accepted")
				fields = [Order_Status]
				format = "font-weight:bold;color:#ffffff;background-color:#2980b9;"
				}
				"Processing"
				{
				condition = (Order_Status == "Order Processing")
				fields = [Order_Status]
				format = "font-weight:bold;color:#ffffff;background-color:#29abb9;"
				}
				"Dispatched"
				{
				condition = (Order_Status == "Order Dispatched")
				fields = [Order_Status]
				format = "font-weight:bold;background-color:#f1c40f;"
				}
				"Delivered"
				{
				condition = (Order_Status == "Order Delivered")
				fields = [Order_Status]
				format = "font-weight:bold;color:#000000;background-color:#27ae60;"
				}
				"Placed"
				{
				condition = (Order_Status == "Order Placed")
				format = "color:#595959;background-color:#e8eefd;"
				}
				"Accepted"
				{
				condition = (Order_Status == "Order Accepted")
				format = "color:#595959;background-color:#7ddaf2;"
				}
				"Processing"
				{
				condition = (Order_Status == "Order Accepted")
				format = "color:#ffffff;background-color:#29abb9;"
				}
				"Dispatched"
				{
				condition = (Order_Status == "Order Processing")
				format = "color:#ffffff;background-color:#1f579b;"
				}
				"Delivered"
				{
				condition = (Order_Status == "Order Delivered")
				format = "color:#ffffff;background-color:#08788b;"
				}
			)
		}
