					actions 
					{
						custom deluge script
						(
											if(input.Nearby_Branch != null)
										{
											fetch_book = Pre_Booking[Nearby_Branch == input.Nearby_Branch && Booking_Date == input.Booking_Date].count();
											if(fetch_book == 10)
											{
