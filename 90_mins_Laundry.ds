<\/span> <\/font><\/p>\n  <\/div>"}}]}]}},{"type":"columns","element":{"split":"5,90,5","id":"u_elem_6334888000000119","elemStyle":"","collayouts":[{"colElements":[{"type":"text","element":{"id":"u_elem_633519099999994","fields":[],"content":"<div style=\"\">\n   <p><br /><\/p>\n  <\/div>"}}]},{"colElements":[{"type":"text","element":{"id":"u_elem_6335193000000119","fields":[],"content":"<div style=\"background-color: rgb(249, 249, 249)\">\n   <p\n      style=\"padding: 20px\"><font color=\"#222222\" size=\"3\"><span>While raising the invoice, if any repeated stock variance is observed, please report it separately along with a detailed analysis to the SKU manager for verification<\/span><\/font><\/p>\n  <\/div>"}}]},{"colElements":[{"type":"text","element":{"id":"u_elem_633519400000006","fields":[],"content":"<div style=\"\">\n   <p><br /><\/p>\n  <\/div>"}}]}]}},{"type":"columns","element":{"split":"100","id":"u_elem_633519599999994","elemStyle":"","collayouts":[{"colElements":[{"type":"text","element":{"id":"u_elem_633519400000006","fields":[],"content":"<div style=\"\">\n   <p><br /><\/p>\n  <\/div>"}}]}]}}],"id":1}],"resize":"A4","header":{"imageId":"","elements":[{"type":"columns","element":{"split":"100","id":"u_elem_6334406999999881","elemStyle":"","collayouts":[{"colElements":[{"type":"text","element":{"id":"u_elem_633440099999994","fields":[],"content":"<div style=\"\">\n   <p><\/p>\n  <\/div>"}}]}]}},{"type":"columns","element":{"split":"100","id":"u_elem_633441400000006","elemStyle":"","collayouts":[{"colElements":[{"type":"text","element":{"id":"u_elem_6334411999999881","fields":[],"content":"<div style=\"\">\n   <h1 style=\"padding-left: 75px\">Inventory Request<\/h1>\n  <\/div>"}}]}]}}],"style":"display: block; background-repeat: no-repeat; border: 0px solid rgb(68, 68, 68); background-size: 100%; background-image: url(https://static.zohocdn.com/creator/appbuilder/images/print-templates/Inventory-header-1.dd992889ee2a2c4d193cea5986272594.png)","bgImg":""},"themeFont":"lato","isHeaderEnabled":true}
				}
			}
		}
		form Inventory_Setup
		{
			displayname = "Inventory Setup"
			success message = "Inventory  Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Branch_ID
			(
				type = picklist	
				displayname = "Branch ID"
				values  = Branch_Setup.ID
    			displayformat = [Branch_ID + " --" + Branch_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Inventory_Category
			(
				type = picklist	
				displayname = "Inventory Category"
				values  = Inventory_Category.ID
    			displayformat = [Category]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Inventory_Items
			(
				type = picklist	
				displayname = "Inventory Items"
				values  = Inventory_Items.ID
    			displayformat = [Items]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Quantity
			(
				type = number
				initial value = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Unit_cost
			(
				displayname = "Unit cost"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Inventory_Cost
			(
				displayname = "Inventory Cost"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Inventory_ID
			(
    			type = text
				displayname = "Inventory ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Date_field
			(
    			type = date
				displayname = "Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Add
					(
   						type = submit
   						displayname = "Add"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Inventory_Update
		{
			displayname = "Inventory Update"
			success message = "Inventory Update Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Booking_ID
			(
    			type = text
				displayname = "Booking ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Sub_Process
			(
    			type = text
				displayname = "Sub Process"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Used_Inventory
			(
				type = grid
				displayname = "Used Inventory"
				must have Inventory_Items
				(
					type = picklist	
					displayname = "Inventory Items"
					values  = Inventory_Items.ID
    				displayformat = [Items]
					sortorder = ascending
					width = medium
				)
				must have Quantity_Used
				(
					type = number
					displayname = "Quantity Used"
					width = medium
				)
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Order_Processing
		{
			displayname = "Order Processing"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Booking_ID
			(
    			type = text
				displayname = "Booking ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Branch_Name
			(
    			type = text
				displayname = "Branch Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Customer_Name
			(
    			type = text
				displayname = "Customer Name"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Customer_Email
			(
    			type = email
				displayname = "Customer Email"
				maxchar = 80
	 			row = 1
	 			column = 2   
				width = medium
				personal data = true
			)
			Sub_Processes
			(
				type = picklist
				displayname = "Sub-Processes"
				maxchar = 100
				values = {"Washing","Drying","Folding","Ironing","Steaming","Stain Treatment","Inspection","Tagging","Packaging","Polishing"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Service_Process
			(
				type = grid
				displayname = "Service Process"
				values  = Service_Process.ID
	 			row = 2
	 			column = 1   
				width = medium
			)
			Section1
			(
				type = section
				displayname = "Section"
	 			row = 3
	 			column = 0   
				width = medium
			)
			must have Order_status
			(
				type = picklist
				displayname = "Order status"
				maxchar = 100
				values = {"Order Processing","Order Dispatched"}
				initial value = "Order Processing"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Completion_Time
			(
				type = number
				displayname = "Completion Time"
				initial value = 0
	 			row = 3
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		print template
			{
				Order_Dispatched
				{
							displayname = "Order Dispatched"
							content = {"pageNumberOption":null,"orientation":"null","images":[{"fileName":"","imageId":"","imageType":"","fileId":""},{"fileName":"1760091276361_Thursday__1_.png","imageId":"img_2860146","imageType":"upload","fileId":"7576805000000010025"},{"fileName":"1760336789809_Gemini_Generated_Image_popzhspopzhspopz.png","imageId":"img_13403602299999982","imageType":"upload","fileId":"7576805000000012025"},{"fileName":"1758612363287_Purple_Sky_Profile_Header__1_.png","imageId":"img_14033291099999994","imageType":"upload","fileId":"7576805000000009065"}],"imageId":"","isFooterEnabled":false,"containerStyle":"","templateStyle":"text-align: left; width: 793.7px; background-image: none","version":"2","layout":"1","mainLayout":[{"elements":[{"type":"columns","element":{"split":"100","id":"u_elem_28540962999999523","elemStyle":"","collayouts":[{"colElements":[{"type":"image","element":{"imageId":"img_2860146","size":"F","src":"https://creator.zoho.in/appbuilder/zappyworkssoftwaresolutionst22/mins-laundry/downLoadImage?imgFileId=7576805000000010025&imgFileName=1760091276361_Thursday__1_.png","parWidth":"100%","captionMargin":"0px auto","alt":"","caption":"","selectFormCompId":"","id":"u_elem_2854095899999976","align":"left","elemStyle":"border: 0px solid rgb(169, 169, 169); margin-right: 10px; width: 100%","formCompId":""}}]}]}},{"type":"columns","element":{"split":"5,95","id":"u_elem_28695831999999285","elemStyle":"","collayouts":[{"colElements":[{"type":"spacer","element":{"id":"u_elem_29010137999999523","height":"25"}}]},{"colElements":[{"type":"text","element":{"Fields":[{"Label_Name":"Customer_Name"}],"id":"u_elem_28695822999999523","content":"<div style=\"background: rgba(0, 0, 0, 0); padding: 0px\">\n   <h1\n      style=\"color: rgb(0, 0, 0); font-weight: 400; font-style: normal; text-align: left\"><font\n        style=\"\"><font style=\"font-size: 16px\">Dear&nbsp;<span\n          style=\"\">${Customer_Name}<\/span><span style=\"color: rgb(0, 0, 0); font-family: La