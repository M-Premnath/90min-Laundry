	reports
	{
		default custom All_Branch_Masters
		{
			displayName = "All Branch Masters"
			show all rows from Branch_Setup    
			(
				Branch_Name as "Branch Name"
				Branch_Address  as "Branch Address"
	 			(
	      			displayformat = [address_line_1+""+address_line_2+""+district_city+""+state_province+""+postal_Code+""+country]
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Contact_Number as "Contact Number"
				(
					displayformat = plainnumber 
					linktodial = enable
				)
				Branch_Image as "Branch Image"
				Branch_ID as "Branch ID"
				Added_User as "Added User"
				Added_Time as "Added Time"
				Modified_User as "Modified User"
				Modified_Time as "Modified Time"
				ID
			)
			custom actions
			(
				"Open Branch Dashboard"
				(
	  			workflow = Open_Dashboard
				show action in view header = true
				show action in edit record menu = true
				confirmation before execution
				(
					message for individual record = "If you want to Open Branch Dashboard for  ${Branch_Name}  ?"
					confirm button text = "Yes"		
					cancel button text = "No"
				)
				)
			)
		}
		default list All_Inventory_Masters
		{
			displayName = "All Inventory Masters"
			show all rows from Inventory_Setup    
			(
				Date_field as "Date"
				Inventory_ID as "Inventory ID"
				Inventory_Category as "Inventory Category"
				Inventory_Items as "Inventory Items"
				Quantity
				Unit_cost as "Unit cost"
				Inventory_Cost as "Inventory Cost"
				Branch_ID as "Branch ID"
				Inventory_Category.Added_Time as "Added Time"
				custom action "Update Quantity"
				(
	  			workflow = Update_Inventory_Quantity
				show action in edit record menu = true
				column header = "Update Quantity"
				)
			)
		}
		default list All_Inventory_Categories
		{
			displayName = "All Inventory Categories"
			show all rows from Inventory_Category    
			(
				Category
			)
		}
		default list All_Inventory_Items
		{
			displayName = "All Inventory Items"
			show all rows from Inventory_Items    
			(
				Items
				Measurement_Unit as "Measurement Unit"
				cost_per_item as "cost per item"
				Inventory_Category as "Inventory Category"
			)
		}
		default custom All_Staff_Masters
		{
			displayName = "All Staff Masters"
			show all rows from Staff_Onboarding    
			(
				Staff_Name  as "Staff Name"
	 			(
	      			displayformat = [first_name+""+prefix+""+last_name+""+suffix]
	 			)
				Staff_Number as "Staff Number"
				(
					displayformat = plainnumber 
					linktodial = enable
				)
				Staff_Address  as "Staff Address"
	 			(
	      			displayformat = [address_line_1+""+address_line_2+""+district_city+""+state_province+""+postal_Code+""+country]
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Staff_Profile as "Staff Profile"
				DOB
				Staff_ID as "Staff ID"
				Gender
				Branch_Preference as "Branch Preference"
				Previous_Experience as "Previous Experience"
				Previous_Shop_Name as "Previous Shop Name"
				Experience_Month as "Experience Month"
				Experience_Years as "Experience Years"
				Branch_Preference.Added_Time as "Onboarded On :"
				(
					displayformat = fulldate
				)
			)
			conditional formatting
			(
				"Fresher"
				{
				condition = (Previous_Experience == "No")
				fields = [Previous_Experience]
				format = "text-decoration:line-through;color:#107c91;"
				}
				"Experience"
				{
				condition = (Previous_Experience == "Yes")
				fields = [Previous_Experience]
				format = "color:#f1c50e;"
				}
			)
		}
		default list All_Service_Masters
		{
			displayName = "All Service Masters"
			show all rows from Service_Master    
			(
				Branch_ID as "Branch ID"
				Service_ID as "Service ID"
				Branch_Name as "Branch Name"
				Service_Details.Service_Type as "Service Details"
			)
		}
		default list All_Cloth_Type
		{
			displayName = "All Cloth Types"
			show all rows from Cloths_Types    
			(
				Cloth_Allowed as "Cloth Allowed"
				Service_Type as "Service Type"
				Cost
			)
			group by
			(
				Service_Type ascending
			)
		}
		default list All_Service_Types1
		{
			displayName = "All Service Types"
			show all rows from Service_Type    
			(
				Service_Type as "Service Type"
				Service_Description as "Service Description"
				Service_Duration as "Service Duration"
				Branch_Master as "Branch Master"
				Service_Type_ID as "Service Type ID"
			)
		}
		default list Pre_Booking_Report
		{
			displayName = "Pre Booking Report"
			show all rows from Pre_Booking    
			(
				Customer_Name  as "Customer Name"
	 			(
	      			displayformat = [prefix+""+first_name+""+last_name+""+suffix]
	 			)
				Customer_Email as "Customer Email"
				CustomerNumber
				(
					displayformat = plainnumber 
					linktodial = enable
				)
				Service_Details.Service_Type as "Service Details"
				Cus_Booking_ID as "Cus Booking ID"
				Nearby_Branch.Branch_Name as "Branch Name"
				custom action "Update Status"
				(
	  			workflow = update_order_status
				show action in view header = true
				show action in edit record menu = true
				column header = "Update Status"
				condition = (Order_Status != "Order Delivered" && Order_Status != "Payment Pending")
				)
				custom action "Track Order"
				(
	  			workflow = Order_Tracker
				show action in view header = true
				show action in edit record menu = true
				column header = "Track Order"
				condition = (Order_Status != "Payment Pending")
				)
				Booking_Date as "Booking Date"
				Nearby_Branch as "Nearby Branch"
				Order_Status as "Order Status"
				Payment_Method as "Payment Method"
				Grand_Total as "Grand Total"
			)
			conditional formatting
			(
				"Placed"
				{
				condition = (Order_Status == "Order Placed")
				fields = [Cus_Booking_ID, Order_Status]
				format = "background-color:#e8eefd;"
				}
				"Accepted"
				{
				condition = (Order_Status == "Order Accepted")
				fields = [Cus_Booking_ID, Order_Status]
				format = "background-color:#aee8da;"
				}
				"Processing"
				{
				condition = (Order_Status == "Order Processing")
				fields = [Cus_Booking_ID, Order_Status]
				format = "background-color:#88dceb;"
				}
				"Dispatched"
				{
				condition = (Order_Status == "Order Dispatched")
				fields = [Cus_Booking_ID, Order_Status]
				format = "background-color:#85adf5;"
				}
				"Delivered"
				{
				condition = (Order_Status == "Order Delivered")
				fields = [Cus_Booking_ID, Order_Status]
				format = "font-weight:bold;color:#ffffff;background-color:#11b1cc;"
				}
				"Pending"
				{
				condition = (Order_Status == "Payment Pending")
				fields = [Cus_Booking_ID]
				format = "color:#000000;background-color:#cbcbcb;"
				}
			)
			customlayouts
			(
				template
	 			(
	 	  			displayname="Custom Layout 1"
	 	  			content="<panel  \n >\n	<pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		padding = '0px'\n	bgColor = '#FFFFFF'\n\n		width = '100%'\n		hAlign = 'center'\n		vAlign = 'middle'\n>\n	<pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		padding = '17px'\n	bgColor = '#FFFFFF'\n\n		width = '20%'\n		hAlign = 'center'\n		vAlign = 'middle'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<image  \n		margin = '0px'\n\n    borderColor = '#FFFFFF'\n    borderWidth = '0px'\n	color = '#FFFFFF'\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	width = '80px'\n	height = '80px'\n	type = 'field'\n	value = 'Nearby_Branch.Branch_Image'\n	cornerRadius = '10px'\n/>\n</pc>\n</pr>\n</pc><pc \n		padding = '0px'\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n\n		width = '80%'\n		hAlign = 'center'\n>\n	<pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		padding = '17px'\n\n		width = '100%'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = '#000000'\n	size = '20px'\n	bold = 'true' \n	fontFamily = 'roboto-regular' \n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '28'\n    numOfLines = '1'\n\n\n\n\n    borderColor = '#000000'\n    borderWidth = '0px'\n\n	  value = 'Customer_Name'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr><pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		paddingTop = '0px'\n	paddingLeft = '17px'\n	paddingRight = '17px'\n	paddingBottom = '17px'\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n\n		width = '100%'\n		hAlign = 'center'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = '#959595'\n	size = '15px'\n	fontFamily = 'RobotoSlab, arimo, sans-serif' \n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '22'\n    numOfLines = '1'\n\n\n\n\n    borderColor = '#000000'\n    borderWidth = '0px'\n\n	  value = 'Cus_Booking_ID'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr><pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		paddingTop = '0px'\n	paddingLeft = '17px'\n	paddingRight = '17px'\n	paddingBottom = '17px'\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n\n    borderColor = '#444444'\n    borderWidth = '0px'\n		width = '31%'\n		hAlign = 'center'\n		vAlign = 'middle'\n    	cornerRadius = '0px'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<image  \n	\n	color = '#000000'\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	type = 'icon'\n	value = 'shopping-shop-location'\n	size = '22px'\n	iconType = 'outline'\n/>\n</pc>\n</pr>\n</pc><pc \n		paddingTop = '7px'\n	paddingLeft = '10px'\n	paddingRight = '17px'\n	paddingBottom = '7px'\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n\n    borderColor = '#444444'\n    borderWidth = '0px'\n		width = '69%'\n		hAlign = 'left'\n		vAlign = 'middle'\n    	cornerRadius = '0px'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = '#000000'\n	size = '16px'\n	italic = 'true' \n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '22'\n    numOfLines = '1'\n\n\n\n\n    borderColor = '#000000'\n    borderWidth = '0px'\n\n	  value = 'Order_Status'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>"
	    		)
			)
		}
		default list All_Payments
		{
			displayName = "All Payments"
			show all rows from Payment    
			(
				Transaction_Amount as "Transaction Amount"
				Branch_Details as "Branch Details"
				Payment_Status as "Payment Status"
				Payment_Date as "Payment Date"
				Service_Type as "Service Type"
				Booking_ID as "Booking ID"
				Cus_Name as "Cus Name"
				Pre_Booking as "Pre Booking"
				Cus_Email as "Cus Email"
			)
			conditional formatting
			(
				"Complete"
				{
				condition = (Payment_Status == "Complete")
				fields = [Payment_Status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"IN Complete"
				{
				condition = (Payment_Status == "In Complete")
				fields = [Payment_Status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
