			Show_only_available_quant as "Show only available quantity"
			{
				type =  form
				form = Inventory_Update
				record event = on add or edit

				on user input of Used_Inventory.Quantity_Used
				{
					actions 
					{
						custom deluge script
						(
											if(row.Quantity_Used != null)
										{
											for each  rec in input.Used_Inventory
											{
												cusBranch = Pre_Booking[Cus_Booking_ID == input.Booking_ID].Nearby_Branch;
												invent_details = Inventory_Setup[Branch_ID == cusBranch && Inventory_Items == rec.Inventory_Items];
												if(invent_details.Quantity <= rec.Quantity_Used)
												{
													alert "Only " + invent_details.Quantity + " Quantity Available.";
													rec.Quantity_Used=null;
												}
												if(rec.Quantity_Used <= 0)
												{
													alert "Negative or zero is not Accepted";
													rec.Quantity_Used=null;
												}
											}
										}
						)
					}
				}

			}
