			Calculate_cost as "Calculate cost"
			{
				type =  form
				form = Pre_Booking
				record event = on add or edit

				on user input of Service_Details.Cloths_Types
				{
					actions 
					{
						custom deluge script
						(
											if(row.Cloths_Types != null)
										{
											cloth_details = Cloths_Types[Cloth_Allowed == row.Cloths_Types.Cloth_Allowed];
											row.Cost=cloth_details.Cost * row.Cloth_Quantity;
											input.Grand_Total = input.Service_Details.sum(Cost);
											// input.Grand_Total = input.IceCream_List.sum(Total_Cost);
										}
						)
					}
				}

			}
			Calculate_cost_Quantity as "Calculate cost - Quantity"
			{
				type =  form
				form = Pre_Booking
				record event = on add or edit

				on user input of Service_Details.Cloth_Quantity
				{
					actions 
					{
						custom deluge script
						(
											if(row.Cloth_Quantity > 0)
										{
											row.Cost=row.Cloths_Types.Cost * row.Cloth_Quantity;
											input.Grand_Total = input.Service_Details.sum(Cost);
										}
										else if(row.Cloth_Quantity <= 0)
										{
											alert "Enter minmun 1 Quantity";
											row.Cloth_Quantity=1;
										}
						)
					}
				}

			}
