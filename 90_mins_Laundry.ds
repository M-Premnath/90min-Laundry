rchange-newline\" /><\/font><\/div><font\n      style=\"font-size: 16px\"><span><\/span><br class=\"Apple-interchange-newline\" />\n\n<\/font><p><\/p>\n  <\/div>"}}]},{"colElements":[{"type":"spacer","element":{"id":"u_elem_13893144799999982","height":"25"}}]}]}},{"type":"columns","element":{"split":"100","id":"u_elem_14028947299999982","elemStyle":"","collayouts":[{"colElements":[{"type":"image","element":{"imageId":"img_14033291099999994","size":"F","src":"https://creator.zoho.in/appbuilder/zappyworkssoftwaresolutionst22/mins-laundry/downLoadImage?imgFileId=7576805000000009065&imgFileName=1758612363287_Purple_Sky_Profile_Header__1_.png","parWidth":"100%","captionMargin":"0px auto","alt":"","caption":"","selectFormCompId":"","id":"u_elem_14028946699999988","align":"left","elemStyle":"border: 0px solid rgb(169, 169, 169); margin-right: 10px; width: 100%","formCompId":""}}]}]}}],"id":1}],"resize":"a4","themeFont":"lato","isHeaderEnabled":false}
				}
			}
		}
		form Order_Verification
		{
			displayname = "Order Verification"
			success message = "Order Approval Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Booking_ID
			(
    			type = text
				displayname = "Booking ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Customer_Name
			(
    			type = name
				displayname = "Customer Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Customer_Email
			(
    			type = email
				displayname = "Customer Email"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Branch_Name
			(
    			type = text
				displayname = "Branch Name"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Order_Status
			(
				type = picklist
				displayname = "Order Status"
				maxchar = 100
				values = {"Order Accepted","Order Delivered"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Pre_Booking
			(
				type = picklist	
				displayname = "Pre Booking"
				values  = Pre_Booking.ID
    			displayformat = [Cus_Booking_ID]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Verification
			(
				type = section
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Verifying_Staff
			(
				type = picklist	
				displayname = "Verifying Staff"
				values  = Staff_Onboarding[Branch_Preference.Branch_Name == input.Branch_Name].ID
    			displayformat = [Staff_ID + " - " + Staff_Name.first_name]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Payment_Status
			(
				type = radiobuttons
				displayname = "Payment Status"
				maxchar = 100
				values = {"Completed","In Complete"}
				layout = 2
	 			row = 2
	 			column = 1   
				width = medium
			)
			Cloths_Received
			(
    			type = checkbox
				displayname = "Cloths Received"
				initial value = false
	 			row = 2
	 			column = 1   
				width = medium
			)
			Cloths_Delivered
			(
    			type = checkbox
				displayname = "Cloths Delivered"
				initial value = false
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
